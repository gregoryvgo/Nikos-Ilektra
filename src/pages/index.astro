---
import Layout from '../layouts/Layout.astro';
import { VideoEnvelope } from '../components/VideoEnvelope';
import { Countdown } from '../components/Countdown';
import { Story } from '../components/Story';
import { Locations } from '../components/Locations';
import { Crew } from '../components/Crew';
import { GiftRegistry } from '../components/GiftRegistry';
import { Poll } from '../components/Poll';
import { Guestbook } from '../components/Guestbook';
import { Footer } from '../components/Footer';
import { eventData } from '../data/event';
---

<Layout title={`${eventData.couple.groom} & ${eventData.couple.bride} Προσκλητήριο`}>
  <main class="flex flex-col min-h-screen">
    <VideoEnvelope
      client:load
      groom={eventData.couple.groom}
      bride={eventData.couple.bride}
      date={eventData.formattedDate}
      churchName="Ι.Ν. Εσταυρωμένου Αιγάλεω"
      imageSrc="/images/nikos-proskitirio.png"
      videoSrc="/Wedding_invitation_envelope_opens_1080p_202608172336.mp4"
    />

    <Countdown
      client:load
      targetDate={eventData.eventDate}
      formattedDate={eventData.formattedDate}
    />

    {/* Κάρτα με τις πληροφορίες δεξίωσης (Πριν το Story) */}
    <section class="py-16 px-6 bg-white text-center">
      <div class="max-w-xl mx-auto">
        <div class="rounded-2xl overflow-hidden shadow-[0_10px_30px_rgba(12,27,51,0.08)] border border-[#dce8f2]">
          <img 
            src="/images/invitation-details.jpg" 
            alt="Πληροφορίες Δεξίωσης" 
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <Story
      client:visible
      title={eventData.story.title}
    />

    <Locations
      client:visible
      ceremony={eventData.locations.ceremony}
      reception={eventData.locations.reception}
    />

    <Crew
      client:visible
      members={eventData.crew}
    />

    <GiftRegistry
      client:visible
      bankName={eventData.bankAccount.bankName}
      iban={eventData.bankAccount.iban}
      beneficiary={eventData.bankAccount.beneficiary}
    />

    <Poll client:only="react" />

    <Guestbook client:only="react" />

    <Footer
      client:visible
      groom={eventData.couple.groom}
      bride={eventData.couple.bride}
    />
  </main>
</Layout>