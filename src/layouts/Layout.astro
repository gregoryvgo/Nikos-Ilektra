---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Νίκος & Ηλέκτρα - Προσκλητήριο Γάμου',
  description = 'Σας προσκαλούμε να γιορτάσετε μαζί μας την πιο ξεχωριστή ημέρα της ζωής μας!',
  // Δείχνουμε τον σωστό τοπικό φάκελο
  image = '/images/og-wedding-final.jpg',
} = Astro.props;

// Επαναφέρουμε τα καθαρά URL για να δουλεύουν άψογα Viber & Instagram
const canonicalURL = new URL(Astro.url.pathname, 'https://nikos-ilektra.vgogenius.gr');
const socialImageURL = new URL(image, canonicalURL).href;
---

<!doctype html>
<html lang="el" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    {/* Keep the essential preview metadata at the start of the document for crawlers reading byte ranges. */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {/* Open Graph / Facebook / WhatsApp / Viber */}
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Νίκος και Ηλέκτρα - Προσκλητήριο Γάμου" />
    
    {/* Προσθέσαμε το παρακάτω για να φύγει το warning */}
    <meta property="fb:app_id" content="2369629840457670" />

    {/* Twitter Preview Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    {/* Google Fonts (GFS Didot, GFS Bodoni, Cormorant Garamond, Marck Script, Montserrat) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=GFS+Bodoni:ital,wght@0,400;0,700;1,400&family=GFS+Didot&family=Marck+Script&family=Montserrat:wght@200;300;400;500&display=swap&subset=greek,greek-ext"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#fcfaf7] text-stone-800 antialiased selection:bg-[#c5a880]/20 selection:text-[#a68a56]">
    <slot />
  </body>
</html>